relative="1" as="geometry"><Array as="points"><mxPoint x="1505" y="357"/></Array></mxGeometry></mxCell><mxCell id="n79" value="7 Needs review" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;exitX=0.75;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="n21" target="n24"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="750" y="240"/><mxPoint x="790" y="240"/><mxPoint x="790" y="690"/></Array></mxGeometry></mxCell><mxCell id="n80" value="Notify" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="n24" target="n15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="65" y="690"/></Array></mxGeometry></mxCell><mxCell id="n81" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n15" target="n25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n82" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n25" target="n26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n83" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n26" target="n27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n84" value="8 Approve / override (task token)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=1;entryY=0.75;" edge="1" parent="1" source="n27" target="n21"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="850" y="790"/><mxPoint x="850" y="205"/></Array></mxGeometry></mxCell><mxCell id="n85" value="&lt;b&gt;MVP flow&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1&lt;/b&gt; Provider signs in to the Amplify Provider Portal (Cognito), uploads CMS-1500 + evidence via pre-signed URL, and tracks claim status.&lt;br&gt;&lt;br&gt;&lt;b&gt;2&lt;/b&gt; S3 Object Created event on EventBridge starts one Step Functions execution per packet.&lt;br&gt;&lt;br&gt;&lt;b&gt;3&lt;/b&gt; Bedrock Data Automation splits, classifies and extracts fields with confidence scores.&lt;br&gt;&lt;br&gt;&lt;b&gt;4&lt;/b&gt; BDA completion event resumes the workflow; claim case JSON is assembled.&lt;br&gt;&lt;br&gt;&lt;b&gt;5&lt;/b&gt; Strands Supervisor on AgentCore Runtime delegates to Validation, Eligibility, Clinical Review and Adjudication agents. Tools via AgentCore Gateway (OAuth token from AgentCore Identity); policies via Knowledge Bases on S3 Vectors.&lt;br&gt;&lt;br&gt;&lt;b&gt;6&lt;/b&gt; Structured recommendation: APPROVE / DENY / PEND, reason codes, evidence citations, confidence.&lt;br&gt;&lt;br&gt;&lt;b&gt;7&lt;/b&gt; Auto-finalize only if all checks pass, confidence is high and amount is under limit. All denials go to an examiner.&lt;br&gt;&lt;br&gt;&lt;b&gt;8&lt;/b&gt; Examiner approves or overrides; decision resumes the workflow and is stored as feedback." style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;fillColor=#F8F8F8;strokeColor=#D5DBDB;align=left;verticalAlign=top;spacing=12;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1720" y="60" width="320" height="560" as="geometry"/></mxCell><mxCell id="n86" value="&lt;b&gt;Agentic Claims Processing (CMS-1500) - MVP&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1720" y="20" width="320" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>