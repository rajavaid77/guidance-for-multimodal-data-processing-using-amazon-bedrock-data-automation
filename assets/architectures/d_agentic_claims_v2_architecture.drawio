abelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1"><mxGeometry x="1786.0" y="856.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="m2m" value="Amazon Cognito M2M pool&lt;br/&gt;client credentials,&lt;br/&gt;scope invoke" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cognito;" vertex="1" parent="1"><mxGeometry x="2065.0" y="860.0" width="40" height="40" as="geometry"/></mxCell><mxCell id="g8" value="Data" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;dashed=1;fillColor=none;strokeColor=#879196;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontColor=#232F3E;fontStyle=1;fontSize=13;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="190" y="1015" width="820" height="275" as="geometry"/></mxCell><mxCell id="vpc" value="VPC: isolated subnets only, no NAT, no internet" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_vpc;strokeColor=#8C4FFF;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#8C4FFF;dashed=0;" vertex="1" parent="1"><mxGeometry x="205" y="1045" width="790" height="235" as="geometry"/></mxCell><mxCell id="aurora" value="Amazon Aurora PostgreSQL&lt;br/&gt;Serverless v2, RDS Data API" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.aurora;" vertex="1" parent="1"><mxGeometry x="868.0" y="1098.0" width="64" height="64" as="geometry"/></mxCell><mxCell id="tables" value="&lt;b&gt;Reference:&lt;/b&gt; plans, members, patients, other_coverage, providers, ref_icd10, ref_procedure, ref_pos, ref_modifier&lt;br/&gt;&lt;b&gt;Claim:&lt;/b&gt; claims (status, current_run), claim_documents, document_batches, claim_document_parts (page ranges), service_lines, extractions&lt;br/&gt;&lt;b&gt;Review:&lt;/b&gt; agent_runs (claim_run_id), decisions, claim_runs (re-run requests), audit_events&lt;br/&gt;&lt;b&gt;Access:&lt;/b&gt; only through the IAM-authorized RDS Data API from the API, workflow and tool Lambdas. Credentials in AWS Secrets Manager." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="220" y="1075" width="585" height="195" as="geometry"/></mxCell><mxCell id="g9" value="Gateway targets (AWS Lambda tools)" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;dashed=1;fillColor=none;strokeColor=#879196;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontColor=#232F3E;fontStyle=1;fontSize=13;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1050" y="1015" width="620" height="275" as="geometry"/></mxCell><mxCell id="t_0" value="validate_codes" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="1106.0" y="1061.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="t_1" value="check_eligibility" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="1246.0" y="1061.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="t_2" value="find_duplicates" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="1386.0" y="1061.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="t_3" value="save_decision" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="1526.0" y="1061.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="tools_note" value="Each tool reads or writes Aurora through the RDS Data API. validate_codes: ICD-10, CPT/HCPCS, POS, modifiers, NPI. check_eligibility: member, plan, coverage on the date of service, COB. find_duplicates: exact match on member, provider, DOS and codes. save_decision: writes only for claims in AGENT_REVIEW." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;fontStyle=2;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1062" y="1155" width="598" height="115" as="geometry"/></mxCell><mxCell id="g10" value="Amazon Bedrock and policy knowledge" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;dashed=1;fillColor=none;strokeColor=#879196;verticalAlign=top;align=left;spacingLeft=42;spacingTop=4;fontColor=#232F3E;fontStyle=1;fontSize=13;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1690" y="1015" width="470" height="275" as="geometry"/></mxCell><mxCell id="fm" value="Foundation models&lt;br/&gt;Claude (reasoning, fast)" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1"><mxGeometry x="1753.0" y="1068.0" width="44" height="44" as="geometry"/></mxCell><mxCell id="grd" value="Bedrock Guardrails&lt;br/&gt;PII mask, prompt-&lt;br/&gt;attack filter" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1"><mxGeometry x="1883.0" y="1068.0" width="44" height="44" as="geometry"/></mxCell><mxCell id="s3_pol" value="Amazon S3&lt;br/&gt;policy documents" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1"><mxGeometry x="1778.0" y="1188.0" width="44" height="44" as="geometry"/></mxCell><mxCell id="kb" value="Bedrock Knowledge Base&lt;br/&gt;Titan Embed Text v2" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1"><mxGeometry x="1968.0" y="1188.0" width="44" height="44" as="geometry"/></mxCell><mxCell id="s3v" value="Amazon S3 Vectors&lt;br/&gt;policy index" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1"><mxGeometry x="2088.0" y="1188.0" width="44" height="44" as="geometry"/></mxCell><mxCell id="pol_note" value="AnyHealth policies and Schedules of Benefits (EoC PDFs), loaded at deploy. Retrieval filtered by plan name." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#232F3E;fontStyle=2;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1705" y="1264" width="450" height="20" as="geometry"/></mxCell><mxCell id="g11" value="Security and observability" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;dashed=1;fillColor=none;strokeColor=#879196;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontColor=#232F3E;fontStyle=1;fontSize=13;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="190" y="1310" width="1970" height="245" as="geometry"/></mxCell><mxCell id="kms" value="AWS KMS&lt;br/&gt;customer-managed&lt;br/&gt;key, rotation on" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.key_management_service;" vertex="1" parent="1"><mxGeometry x="242.0" y="1367.0" width="56" height="56" as="geometry"/></mxCell><mxCell id="sm" value="AWS Secrets Manager&lt;br/&gt;Aurora credentials" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.secrets_manager;" vertex="1" parent="1"><mxGeometry x="402.0" y="1367.0" width="56" height="56" as="geometry"/></mxCell><mxCell id="cw" value="Amazon CloudWatch&lt;br/&gt;logs, metrics,&lt;br/&gt;agent traces" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="1"><mxGeometry x="562.0" y="1367.0" width="56" height="56" as="geometry"/></mxCell><mxCell id="xray" value="AWS X-Ray&lt;br/&gt;Lambda and Step&lt;br/&gt;Functions tracing" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.xray;" vertex="1" parent="1"><mxGeometry x="722.0" y="1367.0" width="56" height="56" as="geometry"/></mxCell><mxCell id="sec_notes" value="&lt;b&gt;Encryption:&lt;/b&gt; one customer-managed KMS key covers the S3 buckets, Aurora, SNS, SQS, log groups, Step Functions, Lambda environment variables, BDA project and blueprints, AgentCore Gateway and Memory. S3 Vectors uses SSE-S3. Buckets block public access, require TLS, are versioned and write server access logs.&lt;br/&gt;&lt;b&gt;Access:&lt;/b&gt; Cognito with MFA, no self sign-up, group checks and provider scoping in the Lambda handlers, WAF on the API stage. Step Functions to Lambda to Runtime uses IAM (SigV4). Runtime to Gateway uses OAuth JWTs, Gateway to Lambda uses the Gateway IAM role.&lt;br/&gt;&lt;b&gt;No PHI in logs:&lt;/b&gt; Step Functions logs at ERROR level without execution data, no API data tracing, SNS carries only the claim ID and a link. VPC flow logs go to CloudWatch Logs.&lt;br/&gt;&lt;b&gt;Compliance:&lt;/b&gt; the services used are HIPAA eligible and a signed AWS BAA is required. cdk-nag (AWS Solutions and HIPAA Security packs) runs at synth." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="880" y="1345" width="1265" height="200" as="geometry"/></mxCell><mxCell id="sec_note2" value="Lambda functions run outside the VPC and reach Aurora only through the Data API.&lt;br/&gt;Claude inference uses cross-Region inference profiles." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;fontStyle=2;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="205" y="1515" width="640" height="30" as="geometry"/></mxCell><mxCell id="e_prov_amp" value="" style="endArrow=block;endFill=1;startArrow=none;startFill=1;html=1;rounded=0;jumpStyle=arc;jumpSize=8;strokeColor=#232F3E;strokeWidth=2;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="u_prov" target="amplify"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="165" y="350"/><mxPoint x="165" y="345"/></Array></mxGeometry></mxCell><mxCell id="c1" value="1" style="ellipse;html=1;whiteSpace=wrap;aspect=fixed;fillColor=#000000;strokeColor=#232F3E;strokeWidth=3;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="125.0" y="337.0" width="26" height="26" as="geometry"/></mxCell><mxCell id="e_exam_amp" value="" style="endArrow=block;endFill=1;startArrow=none;startFill=1;html=1;rounded=0;jumpStyle=arc;jumpSize=8;strokeColor=#232F3E;strokeWidth=2;dashed=0;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="1" source="u_exam" target="amplify"><mxGeometry relative="1" as="geometry"><Array as="poin