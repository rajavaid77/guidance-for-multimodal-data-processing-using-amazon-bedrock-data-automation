as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="21" style="ellipse;html=1;whiteSpace=wrap;aspect=fixed;fillColor=#000000;strokeColor=#8C4FFF;strokeWidth=3;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1309.0" y="502.0" width="26" height="26" as="geometry"/></mxCell><mxCell id="leg_title" value="Step by step" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontColor=#232F3E;fontStyle=1;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="2210" y="12" width="560" height="26" as="geometry"/></mxCell><mxCell id="leg_h0" value="A. Submission and agentic review (black arrows)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#232F3E;fontStyle=1;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="2210" y="58" width="560" height="22" as="geometry"/></mxCell><mxCell id="leg_c1" value="1" style="ellipse;html=1;whiteSpace=wrap;aspect=fixed;fillColor=#000000;strokeColor=#232F3E;strokeWidth=3;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="2211.0" y="87.0" width="26" height="26" as="geometry"/></mxCell><mxCell id="leg_t1" value="The provider signs in to the React SPA hosted on AWS Amplify (Cognito, MFA) and creates a claim." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="2246" y="86" width="520" height="40" as="geometry"/></mxCell><mxCell id="leg_c2" value="2" style="ellipse;html=1;whiteSpace=wrap;aspect=fixed;fillColor=#000000;strokeColor=#232F3E;strokeWidth=3;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="2211.0" y="141.0" width="26" height="26" as="geometry"/></mxCell><mxCell id="leg_t2" value="The SPA calls Amazon API Gateway (WAF, Cognito authorizer). The provider API Lambda stores the claim in Aurora and returns pre-signed S3 URLs." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="2246" y="140" width="520" height="57" as="geometry"/></mxCell><mxCell id="leg_c3" value="3" style="ellipse;html=1;whiteSpace=wrap;aspect=fixed;fillColor=#000000;strokeColor=#232F3E;strokeWidth=3;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="2211.0" y="212.0" width="26" height="26" as="geometry"/></mxCell><mxCell id="leg_t3" value="The browser uploads the CMS-1500 and evidence (single files or packs) to the intake bucket. Submit writes claims/{id}/submit.json." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="2246" y="211" width="520" height="57" as="geometry"/></mxCell><mxCell id="leg_c4" value="4" style="ellipse;html=1;whiteSpace=wrap;aspect=fixed;fillColor=#000000;strokeColor=#232F3E;strokeWidth=3;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="2211.0" y="283.0" width="26" height="26" as="geometry"/></mxCell><mxCell id="leg_t4" value="EventBridge rule ClaimSubmitted starts one ClaimWorkflow execution per claim." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="2246" y="282" width="520" height="40" as="geometry"/></mxCell><mxCell id="leg_c5" value="5" style="ellipse;html=1;whiteSpace=wrap;aspect=fixed;fillColor=#000000;strokeColor=#232F3E;strokeWidth=3;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="2211.0" y="337.0" width="26" height="26" as="geometry"/></mxCell><mxCell id="leg_t5" value="StartBda starts asynchronous Bedrock Data Automation jobs for every document and waits on a task token (up to 1 hour)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="2246" y="336" width="520" height="57" as="geometry"/></mxCell><mxCell id="leg_c6" value="6" style="ellipse;html=1;whiteSpace=wrap;aspect=fixed;fillColor=#000000;strokeColor=#232F3E;strokeWidth=3;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="2211.0" y="408.0" width="26" height="26" as="geometry"/></mxCell><mxCell id="leg_t6" value="BDA writes its JSON to the output bucket. Rule BdaJobFinished runs BdaCallback, which resumes the workflow." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="2246" y="407" width="520" height="40" as="geometry"/></mxCell><mxCell id="leg_c7" value="7" style="ellipse;html=1;whiteSpace=wrap;aspect=fixed;fillColor=#000000;strokeColor=#232F3E;strokeWidth=3;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="2211.0" y="462.0" width="26" height="26" as="geometry"/></mxCell><mxCell id="leg_t7" value="AssembleCase builds case.json, records document parts and extractions in Aurora and cuts page-range PDFs with pypdf." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="2246" y="461" width="520" height="57" as="geometry"/></mxCell><mxCell id="leg_c8" value="8" style="ellipse;html=1;whiteSpace=wrap;aspect=fixed;fillColor=#000000;strokeColor=#232F3E;strokeWidth=3;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="2211.0" y="533.0" width="26" height="26" as="geometry"/></mxCell><mxCell id="leg_t8" value="InvokeAgent calls AgentCore Runtime (SigV4), one session per claim." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="2246" y="532" width="520" height="40" as="geometry"/></mxCell><mxCell id="leg_c9" value="9" style="ellipse;html=1;whiteSpace=wrap;aspect=fixed;fillColor=#000000;strokeColor=#232F3E;strokeWidth=3;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="2211.0" y="587.0" width="26" height="26" as="geometry"/></mxCell><mxCell id="leg_t9" value="The Supervisor runs Validation, Eligibility, Clinical Review and Adjudication. Tools come through AgentCore Gateway with an OAuth token from AgentCore Identity. Memory keeps session context." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="2246" y="586" width="520" height="74" as="geometry"/></mxCell><mxCell id="leg_c10" value="10" style="ellipse;html=1;whiteSpace=wrap;aspect=fixed;fillColor=#000000;strokeColor=#232F3E;strokeWidth=3;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="2211.0" y="675.0" width="26" height="26" as="geometry"/></mxCell><mxCell id="leg_t10" value="Agents call Claude models (reasoning and fast) with a Guardrail. Clinical Review retrieves plan policies from the Knowledge Base on S3 Vectors." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="2246" y="674" width="520" height="57" as="geometry"/></mxCell><mxCell id="leg_c11" value="11" style="ellipse;html=1;whiteSpace=wrap;aspect=fixed;fillColor=#000000;strokeColor=#232F3E;strokeWidth=3;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="2211.0" y="746.0" width="26" height="26" as="geometry"/></mxCell><mxCell id="leg_t11" value="InvokeAgent applies the guards and saves recommendation.json and agent_runs. AUTO goes to Finalize. Every denial, pend or low-confidence case goes to RequestReview." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="2246" y="745" width="520" height="74" as="geometry"/></mxCell><mxCell id="leg_c12" value="12" style="ellipse;html=1;whiteSpace=wrap;aspect=fixed;fillColor=#000000;strokeColor=#232F3E;strokeWidth=3;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="2211.0" y="834.0" width="26" height="26" as="geometry"/></mxCell><mxCell id="leg_t12" value="RequestReview stores the task token and publishes to SNS (claim ID and link only). The execution waits up to 7 days." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="2246" y="833" width="520" height="57" as="geometry"/></mxCell><mxCell id="leg_c13" value="13" style="ellipse;html=1;whiteSpace=wrap;aspect=fixed;fillColor=#000000;strokeColor=#232F3E;strokeWidth=3;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="2211.0" y="905.0" width="26" height="26" as="geometry"/></mxCell><mxCell id="leg_t13" value="The examiner approves or overrides in the UI. The API resumes the task token and Finalize writes the decision to Aurora. The portal polls the status." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="2246" y="904" width="520" height="57" as="geometry"/></mxCell><mxCell id="leg_h14" value="B. Additional documents while a claim is in progress (orange)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#ED7100;fontStyle=1;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="2210" y="981" width="560" height="22" as="geometry"/></mxCell><mxCell id="leg_c14" value="14" style="ellipse;html=1;whiteSpace=wrap;aspect=fixed;fillColor=#000000;strokeColor=#ED7100;strokeWidth=3;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="2211.0" y="1010.0" width="26" height="26" as="geometry"/></mxCell><mxCell id="leg_t14" value="The provider adds up to 10 files from the claim page. The API creates a batch and writes batches/{claim}/{batch}/submit.json." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="2246" y="1009" width="520" height="57" as="geometry"/></mxCell><mxCell id="leg_c15" value="15" style="ellipse;html=1;whiteSpace=wrap;aspect=fixed;fillColor=#000000;strokeColor=#ED7100;strokeWidth=3;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="2211.0" y="1081.0" width="26" height="26" as="geometry"/></mxCell><mxCell id="leg_t15" value="EventBridge rule BatchSubmitted starts ClaimDocumentBatchWorkflow." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="2246" y="1080" width="520" height="40" as="geometry"/></mxCell><mxCell id="leg_c16" value="16" style="ellipse;html=1;whiteSpace=wrap;aspect=fixed;fillColor=#000000;strokeColor=#ED7100;strokeWidth=3;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="2211.0" y="1135.0" width="26" height="26" as="geometry"/></mxCell><mxCell id="leg_t16" value="StartBatchBda runs the same BDA project on the new files." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="2246" y="1134" width="520" height="40" as="geometry"/></mxCell><mxCell id="leg_c17" value="17" style="ellipse;html=1;whiteSpace=wrap;aspect=fixed;fillColor=#000000;strokeColor=#ED7100;strokeWidth=3;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="2211.0" y="1189.0" width="26" height="26" as="geometry"/></mxCell><mxCell id="leg_t17" value="BatchGate polls every 30 seconds until no other review is running (about 1 hour at most). MergeBatch adds the evidence to case.json. The claim form and lines are never replaced." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="2246" y="1188" width="520" height="74" as="geometry"/></mxCell><mxCell id="leg_c18" value="18" style="ellipse;html=1;whiteSpace=wrap;aspect=fixed;fillColor=#000000;strokeColor=#ED7100;strokeWidth=3;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="2211.0" y="1277.0" width="26" height="26" as="geometry"/></mxCell><mxCell id="leg_t18" value="The same Runtime and routing re-review the case. BatchFinish closes the batch and notifies examiners. A finalized claim only records the documents." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="2246" y="1276" width="520" height="57" as="geometry"/></mxCell><mxCell id="leg_h20" value="C. Examiner re-run of the agent review, Mode A (purple)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#8C4FFF;fontStyle=1;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="2210" y="1353" width="560" height="22" as="geometry"/></mxCell><mxCell id="leg_c19" value="19" style="ellipse;html=1;whiteSpace=wrap;aspect=fixed;fillColor=#000000;strokeColor=#8C4FFF;strokeWidth=3;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="2211.0" y="1382.0" width="26" height="26" as="geometry"/></mxCell><mxCell id="leg_t19" value="On a claim in PENDING_REVIEW, FAILED (stored case) or PENDED_INFO_REQUESTED, the examiner clicks Re-run and gives a reason (10 to 1000 characters)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="2246" y="1381" width="520" height="57" as="geometry"/></mxCell><mxCell id="leg_c20" value="20" style="ellipse;html=1;whiteSpace=wrap;aspect=fixed;fillColor=#000000;strokeColor=#8C4FFF;strokeWidth=3;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="2211.0" y="1453.0" width="26" height="26" as="geometry"/></mxCell><mxCell id="leg_t20" value="The API starts ClaimWorkflow with entry = AGENT on the stored case.json, stops a waiting old execution and increments claims.current_run. BDA and extractions are untouched." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="2246" y="1452" width="520" height="74" as="geometry"/></mxCell><mxCell id="leg_c21" value="21" style="ellipse;html=1;whiteSpace=wrap;aspect=fixed;fillColor=#000000;strokeColor=#8C4FFF;strokeWidth=3;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="2211.0" y="1541.0" width="26" height="26" as="geometry"/></mxCell><mxCell id="leg_t21" value="The new run goes through the same agents and guards, but is always routed to a human and never auto-finalized. Old runs, recommendations and decisions are kept and numbered." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="2246" y="1540" width="520" height="74" as="geometry"/></mxCell><mxCell id="leg_frame" value="" style="rounded=1;arcSize=1;fillColor=none;strokeColor=#D5DBDB;html=1;" vertex="1" parent="1"><mxGeometry x="2198" y="4" width="584" height="1628" as="geometry"/></mxCell><mxCell id="aws_logo" value="" style="points=[];outlineConnect=0;gradientColor=none;html=1;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="160" y="1598" width="52" height="52" as="geometry"/></mxCell><mxCell id="copy" value="© 2026, Amazon Web Services, Inc. or its affiliates. All rights reserved." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;fontStyle=2;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="225" y="1612" width="700" height="22" as="geometry"/></mxCell><mxCell id="ref" value="AWS Reference Architecture" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=26;fontColor=#FF9900;fontStyle=1;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1000" y="1602" width="600" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>