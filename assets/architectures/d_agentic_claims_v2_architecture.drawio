<mxfile host="drawio" version="26.0.0"><diagram name="Agentic claims v2" id="agentic-claims-v2"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2790" pageHeight="1700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Guidance for Agentic Claims Processing with &lt;font color=&quot;#232F3E&quot;&gt;Amazon Bedrock Data Automation&lt;/font&gt; and Amazon Bedrock AgentCore" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=32;fontColor=#232F3E;fontStyle=1;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="2400" height="50" as="geometry"/></mxCell><mxCell id="desc" value="This diagram shows how the guidance processes CMS-1500 professional claims and their supporting evidence. Amazon Bedrock Data Automation splits, classifies and extracts every document. A Strands multi-agent reviewer on Amazon Bedrock AgentCore reasons over the case, with tools behind AgentCore Gateway and policy retrieval from Amazon Bedrock Knowledge Bases. AWS Step Functions orchestrates the flow, and deterministic guards decide between auto-finalize and human review. Three flows are numbered: A submission and agentic review, B additional documents while a claim is in progress, C examiner re-run of the agent review." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#232F3E;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="62" width="2150" height="70" as="geometry"/></mxCell><mxCell id="cloud" value="AWS Cloud" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="150" y="150" width="2030" height="1430" as="geometry"/></mxCell><mxCell id="region" value="AWS Region (default us-west-2)" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_region;strokeColor=#00A4A6;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#147EBA;dashed=1;" vertex="1" parent="1"><mxGeometry x="170" y="190" width="1990" height="1370" as="geometry"/></mxCell><mxCell id="u_prov" value="Medical Provider" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=14;fontStyle=1;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.user;" vertex="1" parent="1"><mxGeometry x="39" y="314" width="72" height="72" as="geometry"/></mxCell><mxCell id="u_exam" value="Claims Examiner" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=14;fontStyle=1;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.user;" vertex="1" parent="1"><mxGeometry x="39" y="764" width="72" height="72" as="geometry"/></mxCell><mxCell id="g1" value="Front end and API" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;dashed=1;fillColor=none;strokeColor=#879196;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontColor=#232F3E;fontStyle=1;fontSize=13;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="190" y="235" width="500" height="395" as="geometry"/></mxCell><mxCell id="amplify" value="AWS Amplify Hosting&lt;br/&gt;React SPA: provider portal&lt;br/&gt;and examiner UI" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=top;verticalAlign=bottom;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.amplify;" vertex="1" parent="1"><mxGeometry x="217.0" y="317.0" width="56" height="56" as="geometry"/></mxCell><mxCell id="cognito" value="Amazon Cognito&lt;br/&gt;MFA (TOTP), groups&lt;br/&gt;providers / examiners" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cognito;" vertex="1" parent="1"><mxGeometry x="217.0" y="497.0" width="56" height="56" as="geometry"/></mxCell><mxCell id="waf" value="AWS WAF&lt;br/&gt;rate + managed rules" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=top;verticalAlign=bottom;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.waf;" vertex="1" parent="1"><mxGeometry x="378.0" y="278.0" width="44" height="44" as="geometry"/></mxCell><mxCell id="apigw" value="Amazon API Gateway&lt;br/&gt;REST API, Cognito&lt;br/&gt;authorizer" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;" vertex="1" parent="1"><mxGeometry x="372.0" y="377.0" width="56" height="56" as="geometry"/></mxCell><mxCell id="fn_exam" value="Examiner reviews API&lt;br/&gt;queue, decision,&lt;br/&gt;view links, re-run" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="564.0" y="289.0" width="52" height="52" as="geometry"/></mxCell><mxCell id="fn_prov" value="Provider claims API&lt;br/&gt;claims, batches,&lt;br/&gt;pre-signed URLs,&lt;br/&gt;document view links" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="564.0" y="474.0" width="52" height="52" as="geometry"/></mxCell><mxCell id="g2" value="Intake and eventing" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;dashed=1;fillColor=none;strokeColor=#879196;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontColor=#232F3E;fontStyle=1;fontSize=13;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="710" y="235" width="300" height="395" as="geometry"/></mxCell><mxCell id="s3_in" value="Amazon S3 intake&lt;br/&gt;claims/ and batches/&lt;br/&gt;prefixes" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1"><mxGeometry x="737.0" y="352.0" width="56" height="56" as="geometry"/></mxCell><mxCell id="eb" value="Amazon EventBridge&lt;br/&gt;3 rules" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=top;verticalAlign=bottom;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eventbridge;" vertex="1" parent="1"><mxGeometry x="877.0" y="352.0" width="56" height="56" as="geometry"/></mxCell><mxCell id="dlq" value="Amazon SQS&lt;br/&gt;dead-letter queue" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;" vertex="1" parent="1"><mxGeometry x="933.0" y="508.0" width="44" height="44" as="geometry"/></mxCell><mxCell id="eb_rules" value="&lt;b&gt;Rules&lt;/b&gt;&lt;br/&gt;ClaimSubmitted:&lt;br/&gt;claims/*/submit.json&lt;br/&gt;BatchSubmitted:&lt;br/&gt;batches/*/*/submit.json&lt;br/&gt;BdaJobFinished:&lt;br/&gt;BDA job succeeded or failed" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="722" y="462" width="150" height="125" as="geometry"/></mxCell><mxCell id="g3" value="Orchestration: ClaimWorkflow (AWS Step Functions)" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;dashed=1;fillColor=none;strokeColor=#879196;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontColor=#232F3E;fontStyle=1;fontSize=13;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1050" y="235" width="620" height="395" as="geometry"/></mxCell><mxCell id="sfn" value="AWS Step Functions&lt;br/&gt;ClaimWorkflow" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.step_functions;" vertex="1" parent="1"><mxGeometry x="1072.0" y="352.0" width="56" height="56" as="geometry"/></mxCell><mxCell id="fn_ext" value="Extract&lt;br/&gt;StartBda&lt;br/&gt;BdaCallback" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="1196.0" y="356.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="fn_asm" value="AssembleCase&lt;br/&gt;case.json, parts,&lt;br/&gt;extractions" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="1316.0" y="356.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="fn_inv" value="InvokeAgent&lt;br/&gt;(applies guards)" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="1436.0" y="356.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="entry" value="Entry choice: &lt;b&gt;entry = AGENT&lt;/b&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#F4EEFF;strokeColor=#8C4FFF;dashed=0;fontColor=#232F3E;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1380" y="292" width="160" height="28" as="geometry"/></mxCell><mxCell id="fn_fin" value="Finalize" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="1106.0" y="501.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="fn_rev" value="RequestReview&lt;br/&gt;waitForTaskToken" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="1236.0" y="501.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="guards" value="&lt;b&gt;Deterministic guards&lt;/b&gt;&lt;br/&gt;APPROVE with a failed check = PEND&lt;br/&gt;low extraction confidence caps score&lt;br/&gt;AUTO only if APPROVE, all checks pass,&lt;br/&gt;confidence ≥ 0.9, amount under limit&lt;br/&gt;denial, pend and re-run = human" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFF7E6;strokeColor=#ED7100;dashed=0;fontColor=#232F3E;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1385" y="470" width="275" height="100" as="geometry"/></mxCell><mxCell id="g3_note" value="Lambda errors are retried. Any failure is caught and MarkFailed sets the claim to FAILED." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;fontStyle=2;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1060" y="590" width="560" height="32" as="geometry"/></mxCell><mxCell id="g5" value="Human review" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;dashed=1;fillColor=none;strokeColor=#879196;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontColor=#232F3E;fontStyle=1;fontSize=13;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="190" y="690" width="500" height="295" as="geometry"/></mxCell><mxCell id="sns" value="Amazon SNS review topic&lt;br/&gt;(claim ID and link only)" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sns;" vertex="1" parent="1"><mxGeometry x="572.0" y="758.0" width="56" height="56" as="geometry"/></mxCell><mxCell id="g5_note" value="The examiner opens the claim in the examiner area of the SPA: documents, extracted fields with confidence, findings with citations and line decisions. Approve or override resumes Step Functions through the stored task token, and the decision is recorded in the audit trail. The provider portal polls the claim status." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;fontStyle=2;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="205" y="870" width="470" height="90" as="geometry"/></mxCell><mxCell id="g6" value="Extraction" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;dashed=1;fillColor=none;strokeColor=#879196;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontColor=#232F3E;fontStyle=1;fontSize=13;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="710" y="690" width="300" height="295" as="geometry"/></mxCell><mxCell id="bda" value="Amazon Bedrock&lt;br/&gt;Data Automation" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1"><mxGeometry x="802.0" y="762.0" width="56" height="56" as="geometry"/></mxCell><mxCell id="s3_bda" value="Amazon S3&lt;br/&gt;BDA output" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1"><mxGeometry x="922.0" y="762.0" width="56" height="56" as="geometry"/></mxCell><mxCell id="bda_note" value="&lt;b&gt;Project:&lt;/b&gt; document splitter on; standard output with bounding boxes; custom output.&lt;br/&gt;&lt;b&gt;5 custom blueprints:&lt;/b&gt; CMS-1500, medical record, lab/imaging report, primary payer EOB, hospital discharge summary.&lt;br/&gt;&lt;b&gt;4 AWS-managed:&lt;/b&gt; US medical insurance card, prescription label, US driver license, invoice.&lt;br/&gt;&lt;b&gt;Bucket:&lt;/b&gt; job metadata, standard and custom JSON, case.json, recommendation.json, runs/{n}/ snapshots, parts/ page-range PDFs." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#232F3E;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="720" y="855" width="282" height="128" as="geometry"/></mxCell><mxCell id="g7" value="Orchestration: ClaimDocumentBatchWorkflow (additional documents)" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;dashed=1;fillColor=none;strokeColor=#ED7100;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontColor=#232F3E;fontStyle=1;fontSize=13;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1050" y="690" width="620" height="295" as="geometry"/></mxCell><mxCell id="sfnb" value="AWS Step Functions&lt;br/&gt;ClaimDocument&lt;br/&gt;BatchWorkflow" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.step_functions;" vertex="1" parent="1"><mxGeometry x="1072.0" y="752.0" width="56" height="56" as="geometry"/></mxCell><mxCell id="fn_sbda" value="StartBatchBda" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="1196.0" y="756.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="fn_gate" value="BatchGate&lt;br/&gt;30 s polling,&lt;br/&gt;up to about 1 h" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="1316.0" y="756.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="fn_merge" value="MergeBatch&lt;br/&gt;evidence only" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="1436.0" y="756.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="fn_bfin" value="BatchFinish&lt;br/&gt;MarkBatchFailed" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="1556.0" y="756.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="g7_note" value="Merge never replaces the claim form or service lines. After the merge: REOPEN (a pended claim returns to review through the same routing), re-review in place (PENDING_REVIEW) or RECORD_ONLY (claim already approved, denied or failed). The agent step and routing are the same as in ClaimWorkflow." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;fontStyle=2;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1062" y="862" width="598" height="100" as="geometry"/></mxCell><mxCell id="g4" value="Amazon Bedrock AgentCore" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;dashed=1;fillColor=#F2FBF9;strokeColor=#01A88D;verticalAlign=top;align=left;spacingLeft=44;spacingTop=4;fontColor=#232F3E;fontStyle=1;fontSize=14;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1690" y="235" width="470" height="760" as="geometry"/></mxCell><mxCell id="ac_logo" value="" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1"><mxGeometry x="1707.0" y="242.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="rt" value="AgentCore Runtime: Strands multi-agent app&lt;br/&gt;(one session per claim)" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;dashed=1;fillColor=#FFFFFF;strokeColor=#01A88D;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontColor=#232F3E;fontStyle=1;fontSize=11;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1705" y="275" width="300" height="395" as="geometry"/></mxCell><mxCell id="ag_sup" value="&lt;b&gt;Supervisor&lt;/b&gt; (reasoning model)&lt;br/&gt;runs the specialists as tools, merges findings" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#01A88D;strokeColor=#01A88D;dashed=0;fontColor=#232F3E;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1720" y="322" width="270" height="48" as="geometry"/></mxCell><mxCell id="ag_val" value="&lt;b&gt;Validation&lt;/b&gt; (fast model)&lt;br/&gt;fields, codes, NPI, totals, duplicates" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#01A88D;dashed=0;fontColor=#232F3E;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1720" y="385" width="270" height="42" as="geometry"/></mxCell><mxCell id="ag_elig" value="&lt;b&gt;Eligibility&lt;/b&gt; (fast model)&lt;br/&gt;member, coverage on DOS, COB" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#01A88D;dashed=0;fontColor=#232F3E;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1720" y="440" width="270" height="42" as="geometry"/></mxCell><mxCell id="ag_clin" value="&lt;b&gt;Clinical Review&lt;/b&gt; (reasoning model)&lt;br/&gt;claim vs evidence, medical necessity" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#01A88D;dashed=0;fontColor=#232F3E;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1720" y="495" width="270" height="42" as="geometry"/></mxCell><mxCell id="ag_adj" value="&lt;b&gt;Adjudication&lt;/b&gt; (reasoning model)&lt;br/&gt;line decisions, CARC/RARC, save" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#01A88D;dashed=0;fontColor=#232F3E;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1720" y="550" width="270" height="42" as="geometry"/></mxCell><mxCell id="rt_note" value="Each agent returns typed (Pydantic) structured output. Model output passes the Bedrock Guardrail." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#232F3E;fontStyle=2;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1718" y="608" width="275" height="56" as="geometry"/></mxCell><mxCell id="ecr" value="Amazon ECR&lt;br/&gt;CDK asset image&lt;br/&gt;(ARM64)" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ecr;" vertex="1" parent="1"><mxGeometry x="2065.0" y="300.0" width="40" height="40" as="geometry"/></mxCell><mxCell id="ac_mem" value="AgentCore Memory&lt;br/&gt;per-claim session" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.7